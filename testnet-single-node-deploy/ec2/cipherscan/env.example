# Copy to .env.qedit in the cipherscan clone and fill DB_PASSWORD.
DB_NAME=zcash_explorer
DB_USER=zcash_user
DB_PASSWORD=

NEXT_PUBLIC_NETWORK=testnet
API_CACHE_NAMESPACE=zsatestnet

# Browser-facing URLs, served through the tunnel.
NEXT_PUBLIC_API_URL=https://cipherscan-api.test-zsa.org
CORS_ORIGINS=https://cipherscan.test-zsa.org

NODE_IMAGE=node:22.14.0-bookworm-slim
POSTGRES_IMAGE=postgres:16-bookworm
REDIS_IMAGE=redis:7-bookworm
