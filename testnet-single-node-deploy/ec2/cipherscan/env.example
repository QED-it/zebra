# CipherScan half of /opt/zebra/.env — append these to the file that already
# holds IMAGE, IMAGE_REPO and CF_TUNNEL_TOKEN. Set DB_PASSWORD.
DB_NAME=zcash_explorer
DB_USER=zcash_user
DB_PASSWORD=

# Where the upstream clone lives; the explorer build contexts point at it.
CIPHERSCAN_DIR=/opt/cipherscan

NEXT_PUBLIC_NETWORK=testnet
API_CACHE_NAMESPACE=zsatestnet

# Browser-facing URLs, served through the tunnel. NEXT_PUBLIC_API_URL is what
# repoints the frontend away from upstream's public testnet API — it is baked
# into the bundle at build time, so changing it needs a `--build` of web.
NEXT_PUBLIC_API_URL=https://cipherscan-api.test-zsa.org
CORS_ORIGINS=https://cipherscan.test-zsa.org

NODE_IMAGE=node:22.14.0-bookworm-slim
POSTGRES_IMAGE=postgres:16-bookworm

# Indexer only (profile `indexer`): Zebra's RocksDB, read in secondary mode.
# The node must run with ephemeral = false and bind its cache dir here.
# The leaf is state/v<DATABASE_FORMAT_VERSION>/<network_name lowercased> — v27
# and MyConsensusNet_1 for the config currently mounted on the box.
ZEBRA_STATE_HOST_DIR=/var/lib/zebra-state
ZEBRA_STATE_PATH=/zebra-state/state/v27/myconsensusnet_1
NETWORK=testnet
